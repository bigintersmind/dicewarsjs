{
  "name": "dicewarsjs",
  "version": "1.0.0",
  "description": "A JavaScript implementation of the Dice Wars game",
  "type": "module",
  "homepage": "https://bigintersmind.github.io/dicewarsjs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigintersmind/dicewarsjs.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "sh scripts/test-lock.sh vitest run",
    "test:watch": "vitest",
    "test:coverage": "sh scripts/test-lock.sh vitest run --coverage",
    "benchmark": "vitest run tests/benchmarks/ai.benchmark.js",
    "test:benchmark": "vitest run tests/benchmarks/ai.benchmark.js",
    "lint": "eslint . --ext .js,.jsx,.mjs --max-warnings=100",
    "lint:fix": "eslint . --ext .js,.jsx,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "arena": "node scripts/arena.mjs",
    "arena:sweep": "node scripts/arena-sweep.mjs",
    "arena:bc-stopbias": "node scripts/bc-stopbias-sweep.mjs",
    "behavior:profile": "node scripts/behavior-profile.mjs",
    "new-bot": "node scripts/new-bot.mjs",
    "validate-bot": "node scripts/validate-bot.mjs",
    "benchmark-bot": "node scripts/benchmark-bot.mjs",
    "validate-community-bots": "node scripts/validate-community-bots.mjs",
    "tournament": "node scripts/run-online-tournament.mjs",
    "selfplay": "node scripts/selfplay.mjs",
    "encode-corpus": "node scripts/encode-corpus.mjs",
    "ppo:env-server": "node scripts/ppo-env-server.mjs",
    "ppo:env-smoke": "node scripts/ppo-env-smoke.mjs",
    "ppo:disconnect-smoke": "node scripts/ppo-env-disconnect-smoke.mjs",
    "ppo:booking-smoke": "node scripts/ppo-env-booking-smoke.mjs",
    "ppo:shaped-smoke": "node scripts/ppo-env-shaped-smoke.mjs",
    "ppo:throughput-probe": "node scripts/ppo-throughput-probe.mjs",
    "ppo:league-probe": "node scripts/ppo-league-probe.mjs",
    "ppo:export": "cd ml && python -m dicewars_bc.export_weights --ckpt checkpoints/ppo-tracer.pt --out ../src/ai/ppoPolicyWeights.js --fixture ../tests/fixtures/bc/ppoForwardCases.json",
    "blitz:export": "cd ml && python -m dicewars_bc.export_weights --ckpt runs/ppo-blitz/ppo.pt --out ../src/ai/blitzPolicyWeights.js --fixture ../tests/fixtures/bc/blitzForwardCases.json",
    "survivor:export": "cd ml && python -m dicewars_bc.export_weights --ckpt runs/ppo-survivor/ppo.pt --out ../src/ai/survivorPolicyWeights.js --fixture ../tests/fixtures/bc/survivorForwardCases.json",
    "ppo:gate": "node scripts/ppo-gate.mjs"
  },
  "keywords": [
    "game",
    "strategy",
    "dice"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-vitest": "^0.4.1",
    "husky": "^8.0.0",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix --max-warnings=100",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    ".github/**/*.{yml,yaml}": [
      "prettier --write"
    ]
  },
  "sideEffects": false,
  "dependencies": {
    "pixi.js": "^8.17.1",
    "preact": "^10.29.0"
  }
}
