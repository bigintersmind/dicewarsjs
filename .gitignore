# Dependencies
node_modules/
# Bare form too: a worktree helper symlink named node_modules is a file, not a dir
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ESLint and Prettier
.eslintcache
.stylelintcache
.prettierignore.bak

# Husky
.husky/_

# Build output
dist/
build/
*.min.js
.cache/
.parcel-cache/

# Sound assets at root are legacy; canonical location is public/sound/
sound/

# Vite
.vite/

# Babel cache (legacy)
.babel-cache/

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/
test-results/
benchmark-results/

# MCP tool scratch output
.playwright-mcp/

# Temporary files
*.tmp
*.temp

# ES Module cache
.esm-cache/

# Self-play training data (scripts/selfplay.mjs) — large generated JSONL
data/selfplay/

# Specific files to ignore
**/.claude/settings.local.json

# Don't ignore these files even if they match patterns above
!.gitkeep
